{
  "name": "barbar-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "app": "next build && node scripts/start.mjs",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "reset": "node -e \"require('fs').rmSync('.data',{recursive:true,force:true});console.log('Base de datos borrada. Al arrancar se crean de nuevo los datos de ejemplo.')\"",
    "restore": "node scripts/restore.mjs",
    "typecheck": "next typegen && tsc --noEmit",
